# Server
PORT=8080
ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=hoteluser
DB_PASSWORD=hotelpassword
DB_NAME=hoteldb
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

# Database URL alternative (used in Docker)
DATABASE_URL=postgres://hoteluser:hotelpassword@localhost:5432/hoteldb?sslmode=disable
DB_DRIVER=postgres
DB_PATH=hotel.db

# JWT Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY_HOURS=24

# CORS - frontend origin
CORS_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Locale
DEFAULT_CURRENCY=INR
DEFAULT_TAX_RATE=0.12
DEFAULT_COUNTRY=India
